# Production Environment Configuration
# Copy this to .env.local for local testing, or add directly into your Vercel Dashboard

# ------------------------------------------------------------------------------
# 1. PRIMARY SITE URL (Used for Canonical tags, Open Graph, Sitemap & Schema)
# ------------------------------------------------------------------------------
# Set this to your new custom domain or your primary Vercel URL
NEXT_PUBLIC_SITE_URL=https://dmbilal.vercel.app

# ------------------------------------------------------------------------------
# 2. GOOGLE SEARCH CONSOLE VERIFICATION TOKEN
# ------------------------------------------------------------------------------
# Paste the token from GSC HTML Tag verification (e.g. google-site-verification=abc123xyz)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-google-verification-code-here

# ------------------------------------------------------------------------------
# 3. GOOGLE ANALYTICS 4 (OPTIONAL)
# ------------------------------------------------------------------------------
# Your GA4 Measurement ID (Safe to expose to client)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ------------------------------------------------------------------------------
# 4. ENQUIRY DISPATCH & NOTIFICATIONS (SERVER-SIDE ONLY - NEVER PREFIX WITH NEXT_PUBLIC_)
# ------------------------------------------------------------------------------
# Optional: Slack, Discord, or Telegram incoming webhook to alert you when a brief is submitted
ENQUIRY_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR/WEBHOOK/URL

# Optional: Resend API Key for automatic email delivery to your inbox (dmbilaldev@gmail.com)
RESEND_API_KEY=re_1234567890abcdef

# ------------------------------------------------------------------------------
# 5. DISTRIBUTED RATE LIMITING (OPTIONAL - UPSTASH REDIS)
# ------------------------------------------------------------------------------
# If omitted, the website automatically uses its built-in in-memory rate limiter
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token-here